# Optional overrides for docker compose. Copy to .env (never commit .env).
# Values here are added to the API and worker containers.
ENVIRONMENT=development

# Key that encrypts target credentials (AES-256, base64). compose.yaml has a development key;
# a real deployment must use its own, made with:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# CREDENTIALS_KEY=

# Allow targets on private network addresses, for example a test application on your own
# laptop or an on-premises deployment (NFR-3.4). Leave it off otherwise.
# ALLOW_PRIVATE_TARGETS=true

# Sentra's own AI (the LLM layer, NFR-7.3): a LiteLLM model name, "provider/model". Without one,
# the features that need a model say that no model is configured. Check it with:
#   docker compose run --rm api python -m app.llm.check
# LLM_MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# A local model through Ollama on this laptop instead (no data leaves the laptop):
# LLM_MODEL=ollama/llama3.1
# LLM_API_BASE=http://host.docker.internal:11434

# System health (FR-10.6): where an alert of Screen 63 links to. Empty means no such link.
# With the monitoring profile of compose.yaml:
#   docker compose --profile monitoring up -d
# GRAFANA_URL=http://localhost:3001
# LOGS_URL=
# When set, GET /api/metrics needs "Authorization: Bearer <token>" (NFR-5.5).
# METRICS_TOKEN=
